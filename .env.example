# =============================================================================
# PulseBox Cyber Desk — Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables for your local setup.
# WARNING: NEVER commit .env with real credentials to version control!
#
# Generate a cryptographically secure random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# --- Core Security: Authentication Keys ---
# 1. Admin Token: Required for state-changing actions (/simulate-failure,
#    /restore, /costs/settings, /reset).
PULSEBOX_ADMIN_KEY=your_secure_pulsebox_admin_key_here
PULSEBOX_API_KEY=your_secure_pulsebox_admin_key_here  # Alias for admin key

# 2. Scoped Device Token: Limited token for the ESP32 hardware device.
#    Can only submit telemetry (/record-health-check) and cannot trigger
#    administrative state mutations.
PULSEBOX_DEVICE_KEY=your_scoped_pulsebox_device_key_here

# --- Network & Server Binding ---
# Server host binding. Defaults to 127.0.0.1 (Localhost loopback only).
# For LAN mode (0.0.0.0), set PULSEBOX_ALLOW_LAN=true as an explicit opt-in.
HOST=127.0.0.1
PORT=5000

# Explicit opt-in for binding to 0.0.0.0 (LAN access).
# Set to 'true' only if you intend to allow external devices (e.g. physical ESP32)
# on the trusted local network to query the backend. Default: false
# NOTE: LAN mode over plain HTTP exposes tokens on the local network.
PULSEBOX_ALLOW_LAN=false

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend origins.
# Restricts browser requests to trusted UI origin(s). Wildcards (*) are disallowed.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Rate Limiting ---
# Maximum requests per minute per IP address. Default: 120
RATE_LIMIT_PER_MINUTE=120

# Maximum state-changing (POST) requests per minute per IP. Default: 30
STATE_CHANGE_RATE_LIMIT=30

# --- Optional Alerting Integrations ---
# Telegram Bot integration for automated incident notifications.
# Leave blank or commented out if not using Telegram alerts.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890
