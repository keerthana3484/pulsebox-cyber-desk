# =============================================================================
# PulseBox Cyber Desk Backend - Environment Template
# =============================================================================
# Generate a cryptographically secure random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# --- Core Security: Authentication Keys ---
# Admin key: Full permissions for state changes (/simulate-failure, /restore, /reset, /costs/settings)
PULSEBOX_ADMIN_KEY=your_secure_pulsebox_admin_key_here
PULSEBOX_API_KEY=your_secure_pulsebox_admin_key_here

# Scoped Device Token: Limited token for ESP32 telemetry (/record-health-check)
PULSEBOX_DEVICE_KEY=your_scoped_pulsebox_device_key_here

# --- Network & Server Binding ---
HOST=127.0.0.1
PORT=5000
PULSEBOX_ALLOW_LAN=false

# --- Optional Alerting Integrations ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
