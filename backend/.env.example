# PulseBox Cyber Desk - Telegram Notification Configuration
#
# 1. Create a bot via @BotFather on Telegram (https://t.me/BotFather) to get your TELEGRAM_BOT_TOKEN
# 2. Retrieve your chat ID (e.g. from @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates)
# 3. Copy this file to '.env' inside backend/ (never commit .env to Git) and fill in your values:
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PulseBox Cyber Desk - API Key Authentication (Required for POST endpoints)
# Set a strong, private secret key to protect state mutations (/simulate-failure, /restore, /reset, /record-health-check, /costs/settings).
# Authorized requests must send: Authorization: Bearer <PULSEBOX_API_KEY>
PULSEBOX_API_KEY=your_secret_api_key_here

# Server Network Binding Configuration (Optional):
# HOST=127.0.0.1  # Default: secure localhost only (laptop/browser simulator)
# HOST=0.0.0.0    # Optional: LAN binding for hardware testing with ESP32 on same trusted Wi-Fi
# PORT=5000       # Default port: 5000

