/**
 * =============================================================================
 * PulseBox Cyber Desk — ESP32 Firmware Secrets Template
 * =============================================================================
 * Copy this file to firmware/src/secrets.h if configuring Wi-Fi in the future.
 * 
 * CURRENT STATUS & ARCHITECTURAL NOTE:
 * - The firmware (firmware/src/main.cpp) currently runs entirely offline,
 *   rendering local mock/demo data for display, dirty-region redraw, and touch
 *   validation without making any network or HTTP requests.
 * - Wi-Fi client connectivity and HTTPS GET /state using the pinned Root CA
 *   (ISRG Root X1 in ca_cert.h) are prepared for and planned in the roadmap.
 * - BACKEND_DEVICE_KEY (PULSEBOX_DEVICE_KEY) is OPTIONAL/FUTURE: read-only state
 *   retrieval does not require authentication, and a device token is only needed
 *   if the device is later extended to post telemetry to the Flask backend.
 * 
 * SECURITY RULES (For future Wi-Fi enablement):
 * - NEVER commit secrets.h to git (it is explicitly listed in .gitignore).
 * - Use WPA2/WPA3 Wi-Fi authentication.
 * - Always use pinned Root CA certificates when communicating over TLS/HTTPS.
 * - NEVER call WiFiClientSecure::setInsecure() in production firmware!
 * =============================================================================
 */
#ifndef PULSEBOX_SECRETS_H
#define PULSEBOX_SECRETS_H

// --- Wi-Fi Credentials (Prepared / Planned) ---
#define WIFI_SSID             "YourNetworkSSID"
#define WIFI_PASSWORD         "YourSecureNetworkPassword"

// --- PulseBox Backend Endpoint (Prepared / Planned) ---
// If running on local workstation, provide workstation IP on trusted LAN
#define BACKEND_HOST          "192.168.1.50"
#define BACKEND_PORT          5000

// --- API Authentication: Optional / Future Device Token ---
// Optional future token (PULSEBOX_DEVICE_KEY). Read-only GET /state requires no
// token. This token is only used if the device is configured to post telemetry.
#define BACKEND_DEVICE_KEY    "optional_future_pulsebox_device_token"
#define BACKEND_API_KEY       BACKEND_DEVICE_KEY // Backward compatibility alias

#endif // PULSEBOX_SECRETS_H
